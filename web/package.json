{
  "name": "bonds-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:vditor-assets": "node scripts/sync-vditor-assets.mjs",
    "dev": "bun run sync:vditor-assets && vite",
    "build": "bun run sync:vditor-assets && tsc -b && vite build",
    "check:typescript": "node scripts/check-typescript-version.mjs",
    "lint": "bun run check:typescript && eslint . && node scripts/check-i18n-keys.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "swagger-typescript-api generate -p ../server/docs/swagger.json -o src/api/generated -n api.ts --axios --single-http-client --extract-request-body --extract-response-body --extract-response-error --sort-types --sort-routes --unwrap-response-data --patch --module-name-first-tag --modular && node scripts/fix-generated-imports.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.102.5",
    "antd": "^6.6.1",
    "axios": "^1.20.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "filesize": "^11.0.22",
    "html-react-parser": "^6.1.7",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.12",
    "vditor": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "swagger-typescript-api": "^13.12.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
